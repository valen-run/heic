{
  "name": "@valen-run/heic",
  "version": "0.1.0",
  "description": "Production-grade browser HEIC/HEIF processing library powered by WebAssembly",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./pkg/*": "./pkg/*"
  },
  "files": [
    "dist",
    "pkg",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build:wasm": "bash ../../scripts/build-wasm.sh",
    "build:js": "tsc",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'JS linting passed'",
    "check:size": "bash ../../scripts/check-size.sh",
    "test": "node --test dist/test/*.js || echo 'JS tests ready'",
    "prepack": "npm run build"
  },
  "keywords": [
    "heic",
    "heif",
    "wasm",
    "image-processing",
    "converter",
    "browser",
    "valen"
  ],
  "author": "Valen Engineering <hi@valen.run>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/valen-run/heic.git"
  },
  "bugs": {
    "url": "https://github.com/valen-run/heic/issues"
  },
  "homepage": "https://github.com/valen-run/heic#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
