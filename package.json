{
  "name": "valen-heic-workspace",
  "private": true,
  "description": "Monorepo workspace for @valen-run/heic",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:js": "pnpm --filter @valen-run/heic build:js",
    "build": "pnpm build:wasm && pnpm build:js",
    "check:size": "bash scripts/check-size.sh",
    "typecheck": "pnpm --filter @valen-run/heic typecheck",
    "lint:js": "pnpm --filter @valen-run/heic lint",
    "test:cargo": "cargo test --workspace",
    "test:js": "pnpm --filter @valen-run/heic test",
    "test:browser": "playwright test -c tests/browser/playwright.config.ts",
    "test": "pnpm test:cargo && pnpm test:js",
    "fmt:cargo": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "ci:cargo": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "ci:wasm": "bash scripts/build-wasm.sh && bash scripts/check-size.sh",
    "ci": "pnpm run ci:cargo && pnpm run ci:wasm"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
